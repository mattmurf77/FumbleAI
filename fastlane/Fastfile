require "time"
# fastlane lanes for the Home iPhone app.
#
# The Xcode project is generated by XcodeGen, so run `cd HomeApp && xcodegen generate` first.
# Signing is Xcode automatic signing driven by an App Store Connect API key
# (-allowProvisioningUpdates + -authenticationKey*); no fastlane match, no certificates in git.
#
# Environment (GitHub secrets in .github/workflows/testflight.yml):
#   APP_STORE_CONNECT_KEY_ID      API key ID (10 characters)
#   APP_STORE_CONNECT_ISSUER_ID   Issuer ID (UUID)
#   APP_STORE_CONNECT_KEY_P8      contents of AuthKey_XXXX.p8, base64-encoded
#   HOME_TEAM_ID                  Apple Developer Team ID (10 characters)
#   HOME_BUNDLE_ID                bundle id, e.g. app.fumble.home
#   HOME_SERVER_URL, HOME_API_KEY optional; passed as build settings (Render helper service)
#   BUILD_NUMBER                  optional; CI passes github.run_number

require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

PROJECT = File.expand_path("../HomeApp/Home.xcodeproj", __dir__)
SCHEME = "Home"
OUTPUT_DIR = File.expand_path("../build", __dir__)

def env!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing environment variable #{name}. See docs/setup/TESTFLIGHT.md.") if value.empty?
  value
end

platform :ios do
  desc "Build the Home app and upload it to TestFlight"
  lane :beta do
    key_id = env!("APP_STORE_CONNECT_KEY_ID")
    issuer_id = env!("APP_STORE_CONNECT_ISSUER_ID")
    key_b64 = env!("APP_STORE_CONNECT_KEY_P8")
    team_id = env!("HOME_TEAM_ID")
    bundle_id = env!("HOME_BUNDLE_ID")

    UI.user_error!("#{PROJECT} not found. Run `cd HomeApp && xcodegen generate` first.") unless File.exist?(PROJECT)

    # Accept either base64 of the .p8 or the raw .p8 text.
    key_text = key_b64.include?("BEGIN PRIVATE KEY") ? key_b64 : Base64.decode64(key_b64)
    UI.user_error!("APP_STORE_CONNECT_KEY_P8 does not decode to a .p8 private key.") unless key_text.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_text,
      in_house: false
    )

    # Manual App Store signing. Xcode's automatic signing archives with a development profile first,
    # which Apple won't issue to a team without real devices; distribution certificates and App Store
    # profiles need no devices at all.
    setup_ci(force: true)
    keychain_path = File.expand_path("~/Library/Keychains/#{ENV.fetch('MATCH_KEYCHAIN_NAME', 'fastlane_tmp_keychain')}-db")
    signing_dir = Dir.mktmpdir("signing")

    # Make sure the App IDs exist (no-op when they already do): the app and its share extension.
    share_bundle_id = "#{bundle_id}.share"
    { bundle_id => "Home", share_bundle_id => "Home Share Extension" }.each do |identifier, name|
      begin
        unless Spaceship::ConnectAPI::BundleId.find(identifier)
          UI.message("Registering App ID #{identifier}")
          Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
        end
      rescue => e
        UI.important("Could not check or create the App ID #{identifier}: #{e.message}")
      end
    end

    # Each CI run creates a fresh distribution certificate (its private key lives only in the temporary
    # keychain), and Apple allows only a few. Revoke the ones earlier CI runs created (issued within the
    # last ~2 days) before making a new one. Certificates listed in HOME_KEEP_CERT_IDS are never touched.
    # Revoking a distribution certificate does not affect builds already uploaded to TestFlight.
    keep_ids = ENV.fetch("HOME_KEEP_CERT_IDS", "S4WRTF4QAG").split(",").map(&:strip)
    begin
      Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" }).each do |c|
        next if keep_ids.include?(c.id)
        expires = (Time.parse(c.expiration_date) rescue nil)
        next unless expires && expires > Time.now + (363 * 24 * 3600)
        UI.important("Revoking distribution certificate #{c.id} created by an earlier CI run")
        c.delete!
      end
    rescue => e
      UI.important("Could not clean up old CI certificates: #{e.message}")
    end

    get_certificates(
      api_key: api_key,
      development: false,
      output_path: signing_dir,
      keychain_path: keychain_path,
      keychain_password: ""
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true,
      output_path: signing_dir,
      provisioning_name: "Home App Store (CI)",
      ignore_profiles_with_different_name: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Signing with profile: #{profile_name}")
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: share_bundle_id,
      force: true,
      output_path: signing_dir,
      provisioning_name: "Home Share App Store (CI)",
      ignore_profiles_with_different_name: true
    )
    share_profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Share extension profile: #{share_profile_name}")

    # xcodebuild needs the key as a file for -authenticationKeyPath.
    key_dir = Dir.mktmpdir("asc-key")
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_text)
    File.chmod(0o600, key_path)

    begin
      # Build number: github.run_number, but never lower than what TestFlight already has
      # (so builds uploaded from Xcode on the Mac don't collide).
      version = get_version_number(xcodeproj: PROJECT, target: SCHEME) rescue nil
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id,
        version: (version unless version.to_s.include?("$")),
        initial_build_number: 0
      ).to_i rescue 0
      build_number = [ENV["BUILD_NUMBER"].to_i, latest + 1].max
      UI.message("Build number: #{build_number} (latest on TestFlight: #{latest})")

      auth_flags = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id
      ].map { |a| Shellwords.escape(a) }.join(" ")

      settings = {
        "HOME_BUNDLE_ID" => bundle_id,
        "HOME_TEAM_ID" => team_id,
        "DEVELOPMENT_TEAM" => team_id,
        # Target-scoped signing (project.yml maps these onto the Home target only, so package targets are untouched).
        "HOME_SIGN_STYLE" => "Manual",
        "HOME_SIGN_IDENTITY" => "Apple Distribution",
        "HOME_PROFILE_NAME" => profile_name,
        "HOME_SHARE_PROFILE_NAME" => share_profile_name,
        # The App Store profile can't carry iCloud until the container is set up on the App ID, so
        # TestFlight builds ship without the iCloud entitlement and with sync switched off.
        "HOME_ENTITLEMENTS" => "App/Home-NoCloud.entitlements",
        "HOME_CLOUD_SYNC" => "NO",
        "CURRENT_PROJECT_VERSION" => build_number.to_s
      }
      %w[HOME_SERVER_URL HOME_API_KEY].each do |name|
        settings[name] = ENV[name] unless ENV[name].to_s.strip.empty?
      end
      setting_args = settings.map { |k, v| Shellwords.escape("#{k}=#{v}") }.join(" ")

      build_app(
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        export_team_id: team_id,
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: { bundle_id => profile_name, share_bundle_id => share_profile_name },
          manageAppVersionAndBuildNumber: false
        },
        xcargs: setting_args,
        output_directory: OUTPUT_DIR,
        output_name: "Home.ipa",
        include_symbols: true,
        clean: true
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: bundle_id,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      FileUtils.rm_rf(key_dir)
    end
  end
  desc "Print the processing state of recent TestFlight builds (diagnostics; no build or upload)"
  lane :status do
    key_b64 = env!("APP_STORE_CONNECT_KEY_P8")
    key_text = key_b64.include?("BEGIN PRIVATE KEY") ? key_b64 : Base64.decode64(key_b64)
    app_store_connect_api_key(
      key_id: env!("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: env!("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_text,
      in_house: false
    )
    bundle_id = env!("HOME_BUNDLE_ID")
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No App Store Connect app found for #{bundle_id}") unless app
    UI.message("App: #{app.name} (id #{app.id}, bundle #{app.bundle_id})")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
    UI.important("No builds found for this app.") if builds.empty?
    builds.each do |b|
      UI.message("build #{b.version} | state=#{b.processing_state} | uploaded=#{b.uploaded_date} | expired=#{b.expired} | min_os=#{b.min_os_version}")
    end
  end
end
