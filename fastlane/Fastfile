require "time"
require_relative "home_brief_catalog"
require_relative "home_brief_review"
require_relative "home_storefront_status"
require_relative "home_storefront_draft"
require_relative "home_draft_build"
require_relative "home_listing_screenshots"
# fastlane lanes for the Home iPhone app.
#
# The Xcode project is generated by XcodeGen, so run `cd HomeApp && xcodegen generate` first.
# CI uses manual App Store signing and a temporary keychain.
#
# Environment (GitHub secrets in .github/workflows/testflight.yml):
#   APP_STORE_CONNECT_KEY_ID      API key ID (10 characters)
#   APP_STORE_CONNECT_ISSUER_ID   Issuer ID (UUID)
#   APP_STORE_CONNECT_KEY_P8      contents of AuthKey_XXXX.p8, base64-encoded
#   HOME_TEAM_ID                  Apple Developer Team ID (10 characters)
#   HOME_BUNDLE_ID                bundle id, e.g. app.fumble.home
#   HOME_SERVER_URL, HOME_API_KEY optional; passed as build settings (Render helper service)
#   BUILD_NUMBER                  optional; CI passes github.run_number

require "base64"
require "open3"
require "shellwords"
require "tempfile"
require "tmpdir"

default_platform(:ios)

PROJECT = File.expand_path("../HomeApp/Home.xcodeproj", __dir__)
SCHEME = "Home"
OUTPUT_DIR = File.expand_path("../build", __dir__)

def env!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing environment variable #{name}. See docs/setup/TESTFLIGHT.md.") if value.empty?
  value
end

platform :ios do
  desc "Build the Home app and upload it to TestFlight"
  lane :beta do
    key_id = env!("APP_STORE_CONNECT_KEY_ID")
    issuer_id = env!("APP_STORE_CONNECT_ISSUER_ID")
    key_b64 = env!("APP_STORE_CONNECT_KEY_P8")
    team_id = env!("HOME_TEAM_ID")
    bundle_id = env!("HOME_BUNDLE_ID")

    UI.user_error!("#{PROJECT} not found. Run `cd HomeApp && xcodegen generate` first.") unless File.exist?(PROJECT)

    # Accept either base64 of the .p8 or the raw .p8 text.
    key_text = key_b64.include?("BEGIN PRIVATE KEY") ? key_b64 : Base64.decode64(key_b64)
    UI.user_error!("APP_STORE_CONNECT_KEY_P8 does not decode to a .p8 private key.") unless key_text.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_text,
      in_house: false
    )

    # Manual App Store signing. Xcode's automatic signing archives with a development profile first,
    # which Apple won't issue to a team without real devices; distribution certificates and App Store
    # profiles need no devices at all.
    setup_ci(force: true)
    keychain_path = File.expand_path("~/Library/Keychains/#{ENV.fetch('MATCH_KEYCHAIN_NAME', 'fastlane_tmp_keychain')}-db")
    signing_dir = Dir.mktmpdir("signing")

    p12 = ENV.delete("HOME_DISTRIBUTION_P12_BASE64").to_s
    password = ENV.delete("HOME_DISTRIBUTION_P12_PASSWORD").to_s
    if p12.empty? != password.empty?
      UI.user_error!("Set both HOME_DISTRIBUTION_P12_BASE64 and HOME_DISTRIBUTION_P12_PASSWORD to reuse a signing identity.")
    end
    unless p12.empty?
      begin
        certificate = Base64.strict_decode64(p12.delete(" \t\r\n"))
      rescue ArgumentError
        UI.user_error!("HOME_DISTRIBUTION_P12_BASE64 must contain a base64-encoded PKCS#12 file.")
      end
      Tempfile.create(["home-distribution-", ".p12"]) do |file|
        file.binmode
        file.write(certificate)
        file.close
        import_certificate(certificate_path: file.path, certificate_format: "pkcs12",
                           certificate_password: password, keychain_path: keychain_path,
                           keychain_password: "", log_output: false)
      end
      identities, status = Open3.capture2e("security", "find-identity", "-v", "-p", "codesigning", keychain_path)
      unless status.success? && identities.match?(/"Apple Distribution: [^"\n]+ \(#{Regexp.escape(team_id)}\)"/)
        UI.user_error!("The imported file must include a valid Apple Distribution certificate and private key for HOME_TEAM_ID.")
      end
    end

    # Make sure the App IDs exist (no-op when they already do): the app and its share extension.
    share_bundle_id = "#{bundle_id}.share"
    { bundle_id => "Home", share_bundle_id => "Home Share Extension" }.each do |identifier, name|
      begin
        unless Spaceship::ConnectAPI::BundleId.find(identifier)
          UI.message("Registering App ID #{identifier}")
          Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
        end
      rescue => e
        UI.important("Could not check or create the App ID #{identifier}: #{e.message}")
      end
    end

    # Distribution certificates may also sign the publisher's other apps. Never revoke
    # an existing certificate to make room for this build. Stop if Apple has no slot.
    get_certificates(
      api_key: api_key,
      development: false,
      output_path: signing_dir,
      keychain_path: keychain_path,
      keychain_password: ""
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true,
      output_path: signing_dir,
      provisioning_name: "Home App Store (CI)",
      ignore_profiles_with_different_name: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Signing with profile: #{profile_name}")
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: share_bundle_id,
      force: true,
      output_path: signing_dir,
      provisioning_name: "Home Share App Store (CI)",
      ignore_profiles_with_different_name: true
    )
    share_profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Share extension profile: #{share_profile_name}")

    # xcodebuild needs the key as a file for -authenticationKeyPath.
    key_dir = Dir.mktmpdir("asc-key")
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_text)
    File.chmod(0o600, key_path)

    begin
      # Build number: github.run_number, but never lower than what TestFlight already has
      # (so builds uploaded from Xcode on the Mac don't collide).
      version = get_version_number(xcodeproj: PROJECT, target: SCHEME) rescue nil
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id,
        version: (version unless version.to_s.include?("$")),
        initial_build_number: 0
      ).to_i rescue 0
      build_number = [ENV["BUILD_NUMBER"].to_i, latest + 1].max
      UI.message("Build number: #{build_number} (latest on TestFlight: #{latest})")

      auth_flags = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id
      ].map { |a| Shellwords.escape(a) }.join(" ")

      settings = {
        "HOME_BUNDLE_ID" => bundle_id,
        "HOME_TEAM_ID" => team_id,
        "DEVELOPMENT_TEAM" => team_id,
        # Target-scoped signing (project.yml maps these onto the Home target only, so package targets are untouched).
        "HOME_SIGN_STYLE" => "Manual",
        "HOME_SIGN_IDENTITY" => "Apple Distribution",
        "HOME_PROFILE_NAME" => profile_name,
        "HOME_SHARE_PROFILE_NAME" => share_profile_name,
        # The App Store profile can't carry iCloud until the container is set up on the App ID, so
        # TestFlight builds ship without the iCloud entitlement and with sync switched off.
        "HOME_ENTITLEMENTS" => "App/Home-NoCloud.entitlements",
        "HOME_CLOUD_SYNC" => "NO",
        "CURRENT_PROJECT_VERSION" => build_number.to_s
      }
      %w[HOME_SERVER_URL HOME_API_KEY].each do |name|
        settings[name] = ENV[name] unless ENV[name].to_s.strip.empty?
      end
      setting_args = settings.map { |k, v| Shellwords.escape("#{k}=#{v}") }.join(" ")

      build_app(
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        export_team_id: team_id,
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: { bundle_id => profile_name, share_bundle_id => share_profile_name },
          manageAppVersionAndBuildNumber: false
        },
        xcargs: setting_args,
        output_directory: OUTPUT_DIR,
        output_name: "Home.ipa",
        include_symbols: true,
        clean: true
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: bundle_id,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      FileUtils.rm_rf(key_dir)
    end
  end
  private_lane :connect_home_status_app do
    key_b64 = env!("APP_STORE_CONNECT_KEY_P8")
    key_text = key_b64.include?("BEGIN PRIVATE KEY") ? key_b64 : Base64.decode64(key_b64)
    app_store_connect_api_key(
      key_id: env!("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: env!("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_text,
      in_house: false
    )
    bundle_id = env!("HOME_BUNDLE_ID")
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No App Store Connect app found for #{bundle_id}") unless app
    app
  end

  desc "Read TestFlight, the Home Brief catalog and Home Blueprint's public version metadata"
  lane :status do
    app = connect_home_status_app
    UI.message("App: #{app.name} (id #{app.id}, bundle #{app.bundle_id})")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
    UI.important("No builds found for this app.") if builds.empty?
    builds.each do |b|
      UI.message("build #{b.version} | state=#{b.processing_state} | uploaded=#{b.uploaded_date} | expired=#{b.expired} | min_os=#{b.min_os_version}")
    end
    if app.id == HomeBriefCatalog::APP_ID
      client = HomeBriefCatalog::Client.new(Spaceship::ConnectAPI.token)
      # Build inventory and signing-resource access are separate Apple capabilities.
      # Probe current access with GET only; get_certificates can create a certificate.
      {
        "CI certificate access" => ["/v1/certificates", {"limit" => "1", "fields[certificates]" => "certificateType,expirationDate"}],
        "CI bundle registration access" => ["/v1/bundleIds", {"filter[identifier]" => app.bundle_id, "limit" => "1"}]
      }.each do |label, (path, params)|
        begin
          result = client.get(path, params)
          UI.message("#{label}: available (returned records=#{result.fetch('data').length})")
        rescue HomeBriefCatalog::ApiError => error
          UI.important("#{label}: #{error.message}")
        end
      end
      HomeStorefrontStatus.new(client, app_id: app.id, log: ->(message) { UI.message(message) }).report
      begin
        HomeBriefCatalog::Product.new(client, app_id: app.id, bundle_id: app.bundle_id, log: ->(message) { UI.message(message) }).status
      rescue HomeBriefCatalog::ApiError => error
        UI.important("Home Brief catalog check incomplete: #{error.message}")
      end
    end
  end

  desc "Set up a draft non-consumable for the existing Home Blueprint app (manual only)"
  lane :prepare_home_brief do |options|
    app = connect_home_status_app
    client = HomeBriefCatalog::Client.new(Spaceship::ConnectAPI.token, write: true)
    product = HomeBriefCatalog::Product.new(client, app_id: app.id, bundle_id: app.bundle_id, log: ->(message) { UI.message(message) })
    product.provision(resume_id: options[:resume_id])
  end

  desc "Attach three verified iPhone listing screenshots to the Home Blueprint 1.0 en-US draft"
  lane :attach_home_listing_screenshots do
    unless ENV["GITHUB_ACTIONS"] == "true" && ENV["GITHUB_REPOSITORY"] == "mattmurf77/FumbleAI" && /\A[1-9][0-9]*\z/.match?(ENV["HOME_LISTING_SCREENSHOT_RUN"].to_s)
      UI.user_error!("Use the catalog-only TestFlight workflow with listing_screenshot_run.")
    end
    images = HomeListingScreenshots.images(File.join(env!("RUNNER_TEMP"), "home-listing-screenshots"))
    app = connect_home_status_app
    client = HomeListingScreenshots::Client.new(Spaceship::ConnectAPI.token)
    HomeListingScreenshots::Upload.new(client, app_id: app.id).run(images)
    UI.success("Verified Home, Equipment and Home History screenshots on the en-US 1.0 draft.")
  end

  desc "Select one processed iOS 1.0 build on the empty Home Blueprint draft"
  lane :select_home_draft_build do
    unless ENV["GITHUB_ACTIONS"] == "true" && ENV["GITHUB_REPOSITORY"] == "mattmurf77/FumbleAI" && ENV["HOME_BUILD_SELECTION_ONLY"] == "true"
      UI.user_error!("Use the catalog-only TestFlight workflow with an explicit select_build_number.")
    end
    number = env!("HOME_SELECTED_BUILD")
    app = connect_home_status_app
    client = HomeDraftBuild::Client.new(Spaceship::ConnectAPI.token)
    outcome = HomeDraftBuild::Selection.new(client, app_id: app.id, number: number).run
    UI.success("Home Blueprint iOS 1.0 draft: build #{number} #{outcome == :selected ? 'selected and verified' : 'already selected'}.")
  end

  desc "Fill blank fields only on the existing Home Blueprint 1.0 en-US storefront draft"
  lane :fill_home_storefront_draft do
    unless ENV["GITHUB_ACTIONS"] == "true" && ENV["GITHUB_REPOSITORY"] == "mattmurf77/FumbleAI" && ENV["HOME_STOREFRONT_DRAFT_ONLY"] == "true"
      UI.user_error!("Use the catalog-only TestFlight workflow with fill_storefront_draft.")
    end
    app = connect_home_status_app
    client = HomeStorefrontDraft::Client.new(Spaceship::ConnectAPI.token)
    HomeStorefrontDraft::Editor.new(client, app_id: app.id, log: ->(message) { UI.message(message) }).run
  end

  desc "Attach the verified iPhone Home Brief screenshot to its existing Apple review draft"
  lane :attach_home_brief_review do
    unless ENV["GITHUB_ACTIONS"] == "true" && ENV["GITHUB_REPOSITORY"] == "mattmurf77/FumbleAI" && /\A[1-9][0-9]*\z/.match?(ENV["REVIEW_RUN_ID"].to_s)
      UI.user_error!("Use the catalog-only TestFlight workflow with an explicit verified iOS run ID.")
    end
    bytes = HomeBriefReview.attachment(File.join(env!("RUNNER_TEMP"), "home-brief-review"))
    app = connect_home_status_app
    client = HomeBriefReview::Client.new(Spaceship::ConnectAPI.token)
    result = HomeBriefReview::Upload.new(client, app_id: app.id, bundle_id: app.bundle_id).call(bytes)
    UI.success("Home Brief review screenshot verified. Review notes: #{result == :complete ? 'saved and verified' : 'existing text preserved'}.")
  end
end
