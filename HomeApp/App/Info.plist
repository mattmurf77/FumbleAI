<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.fumble.home.refresh</string>
		<string>app.fumble.home.maintenance</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Home Blueprint</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Project history spreadsheet</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Home Blueprint</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>home</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>HomeAPIKey</key>
	<string>$(HOME_API_KEY)</string>
	<key>HomeCloudSync</key>
	<string>$(HOME_CLOUD_SYNC)</string>
	<key>HomeContractorPartnerDisclosure</key>
	<string>$(HOME_CONTRACTOR_PARTNER_DISCLOSURE)</string>
	<key>HomeContractorPartnerName</key>
	<string>$(HOME_CONTRACTOR_PARTNER_NAME)</string>
	<key>HomeContractorPartnerURL</key>
	<string>$(HOME_CONTRACTOR_PARTNER_URL)</string>
	<key>HomeFinancingPartnerDisclosure</key>
	<string>$(HOME_FINANCING_PARTNER_DISCLOSURE)</string>
	<key>HomeFinancingPartnerName</key>
	<string>$(HOME_FINANCING_PARTNER_NAME)</string>
	<key>HomeFinancingPartnerURL</key>
	<string>$(HOME_FINANCING_PARTNER_URL)</string>
	<key>HomeKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(HOME_BUNDLE_ID).shared</string>
	<key>HomeServerURL</key>
	<string>$(HOME_SERVER_URL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Home adds your chores to the calendar you choose, including Google calendars added to this iPhone, and updates or removes those events when you edit or delete a chore.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Home adds your chores to the calendar you choose, including Google calendars added to this iPhone, and updates or removes those events when you edit or delete a chore.</string>
	<key>NSCameraUsageDescription</key>
	<string>Home uses the camera to scan rooms into a floor plan, capture a paper floor plan, and scan receipts and item photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Home Blueprint listens when you tap the microphone so you can add to-dos, project ideas or feedback by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Home Blueprint turns what you say into to-dos, project ideas or feedback text. Recognition runs on your iPhone when it can; otherwise Apple processes the audio.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
